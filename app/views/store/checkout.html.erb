<% content_for :title, "Sipariş alındı" %>

<div class="store-done">
  <div class="check-circle check-circle--ok">
    <svg viewBox="0 0 24 24" width="40" height="40" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M20 6 9 17l-5-5"/>
    </svg>
  </div>
  <h1>Siparişin alındı 🎉</h1>
  <p class="subtle">Sipariş numaran: <strong><%= @reference %></strong>. Kargo bilgisi e-postana gönderildi.</p>
  <%= link_to "Alışverişe devam et", store_path, class: "btn" %>
</div>
