<% content_for :title, "Simülasyon" %>

<div class="page-head">
  <div>
    <h1>Otonom ajan → ajan simülasyonu</h1>
    <p class="subtle">
      Küçük bir canlı sistemde <strong>gerçek arızalar</strong> üretilir; gözlemci metriklerden saptar;
      ajan <strong>Jev</strong> (System One) ile karar verip aksiyonu <strong>gerçekten uygular</strong> ve
      sağlık yeniden ölçülür. "Çözüldü" = servis gerçekten düzeldi. Çıkmaza girerse o an nöbetçi olan
      kişiye Telegram'dan alarm basar.
    </p>
  </div>
  <div class="transitions">
    <%= form_with url: run_simulation_path, method: :post, class: "inline-form" do |f| %>
      <%= f.number_field :count, value: 5, min: 1, max: 20, class: "field" %>
      <%= f.submit "Olay üret ve ajana ver", class: "btn" %>
    <% end %>
    <button type="button" id="live-toggle" class="btn btn--secondary">▶ Canlı mod</button>
    <% if @stats[:total].to_i.positive? %>
      <%= button_to "Temizle", reset_simulation_path, method: :post, class: "btn btn--ghost btn--sm",
            data: { turbo_confirm: "Tüm simüle olaylar silinsin mi?" } %>
    <% end %>
  </div>
</div>

<div class="dedup-note">
  Karar motoru:
  <strong><%= @using_jev ? "GERÇEK Jev (TypeSafe System One)" : "StubJevClient (sahte — API anahtarı yok)" %></strong>.
  <span id="live-status" class="subtle"></span>
</div>

<div class="card">
  <h2 style="font-size:16px;margin:0 0 12px">Kendi olayını çözdür</h2>
  <p class="subtle" style="margin:0 0 12px">
    Bir arıza yaz; ajan onu Jev ile değerlendirip bir aksiyon seçsin ve çözsün.
    (Çözüp çözemediğini de Jev değerlendirir — bu olayların gizli "doğru cevabı" yoktur.)
  </p>
  <%= form_with url: submit_simulation_path, method: :post do |f| %>
    <div class="form-row">
      <div class="field">
        <%= f.label :service_id, "Servis" %>
        <%= f.select :service_id, @services.map { |s| [ s.name, s.id ] } %>
      </div>
      <div class="field">
        <%= f.label :urgency, "Aciliyet" %>
        <%= f.select :urgency, [ [ "Yüksek", "high" ], [ "Düşük", "low" ] ] %>
      </div>
    </div>
    <div class="field">
      <%= f.label :title, "Olay başlığı" %>
      <%= f.text_field :title, placeholder: "ör. Ödeme servisi son dağıtımdan sonra 500 veriyor", required: true %>
    </div>
    <div class="field">
      <%= f.label :details, "Ayrıntı (Jev'in okuyacağı durum)" %>
      <%= f.text_area :details, rows: 3, placeholder: "ör. /charge üzerinde %20 hata, 14:02 deploy'undan hemen sonra; gecikme ve kaynak normal." %>
    </div>
    <%= f.submit "Ajana ver ve çözdür", class: "btn" %>
  <% end %>
</div>

<div id="board">
  <%= render "board" %>
</div>

<script>
  (function () {
    var token  = document.querySelector('meta[name="csrf-token"]').content;
    var btn    = document.getElementById('live-toggle');
    var status = document.getElementById('live-status');
    var live   = false;
    var timer  = null;
    var DELAY  = 3500; // ms between incidents

    function tick() {
      status.textContent = '· canlı: yeni olay üretiliyor…';
      fetch('<%= tick_simulation_path %>', {
        method: 'POST',
        headers: { 'X-CSRF-Token': token, 'Accept': 'text/html' }
      })
      .then(function (r) { return r.text(); })
      .then(function (html) {
        document.getElementById('board').innerHTML = html;
        if (live) {
          status.textContent = '· canlı: bir sonraki olaya ' + (DELAY / 1000) + ' sn…';
          timer = setTimeout(tick, DELAY);
        }
      })
      .catch(function () {
        status.textContent = '· canlı mod hata aldı, durduruldu';
        stop();
      });
    }

    function start() {
      live = true;
      btn.textContent = '⏸ Canlı modu durdur';
      btn.classList.add('btn--secondary');
      tick();
    }

    function stop() {
      live = false;
      if (timer) { clearTimeout(timer); timer = null; }
      btn.textContent = '▶ Canlı mod';
      status.textContent = '';
    }

    btn.addEventListener('click', function () { live ? stop() : start(); });
  })();
</script>
