<% content_for :title, "Simülasyon" %>

<div class="page-head">
  <div>
    <h1>Otonom ajan → ajan simülasyonu</h1>
    <p class="subtle">
      Simülatör sahte arızalar üretir; çözüm ajanı her olayı <strong>Jev</strong> (TypeSafe System One)
      ile değerlendirip otomatik çözer. Çıkmaza girerse o an nöbetçi olan insana alarm basar.
    </p>
  </div>
  <div class="transitions">
    <%= form_with url: run_simulation_path, method: :post, class: "inline-form" do |f| %>
      <%= f.number_field :count, value: 5, min: 1, max: 20, class: "field" %>
      <%= f.submit "Olay üret ve ajana ver", class: "btn" %>
    <% end %>
    <button type="button" id="live-toggle" class="btn btn--secondary">▶ Canlı mod</button>
    <% if @stats[:total].to_i.positive? %>
      <%= button_to "Temizle", reset_simulation_path, method: :post, class: "btn btn--ghost btn--sm",
            data: { turbo_confirm: "Tüm simüle olaylar silinsin mi?" } %>
    <% end %>
  </div>
</div>

<div class="dedup-note">
  Karar motoru:
  <strong><%= @using_jev ? "GERÇEK Jev (TypeSafe System One)" : "StubJevClient (sahte — API anahtarı yok)" %></strong>.
  <span id="live-status" class="subtle"></span>
</div>

<div id="board">
  <%= render "board" %>
</div>

<script>
  (function () {
    var token  = document.querySelector('meta[name="csrf-token"]').content;
    var btn    = document.getElementById('live-toggle');
    var status = document.getElementById('live-status');
    var live   = false;
    var timer  = null;
    var DELAY  = 3500; // ms between incidents

    function tick() {
      status.textContent = '· canlı: yeni olay üretiliyor…';
      fetch('<%= tick_simulation_path %>', {
        method: 'POST',
        headers: { 'X-CSRF-Token': token, 'Accept': 'text/html' }
      })
      .then(function (r) { return r.text(); })
      .then(function (html) {
        document.getElementById('board').innerHTML = html;
        if (live) {
          status.textContent = '· canlı: bir sonraki olaya ' + (DELAY / 1000) + ' sn…';
          timer = setTimeout(tick, DELAY);
        }
      })
      .catch(function () {
        status.textContent = '· canlı mod hata aldı, durduruldu';
        stop();
      });
    }

    function start() {
      live = true;
      btn.textContent = '⏸ Canlı modu durdur';
      btn.classList.add('btn--secondary');
      tick();
    }

    function stop() {
      live = false;
      if (timer) { clearTimeout(timer); timer = null; }
      btn.textContent = '▶ Canlı mod';
      status.textContent = '';
    }

    btn.addEventListener('click', function () { live ? stop() : start(); });
  })();
</script>
