<% if @stats[:total].to_i.positive? %>
  <div class="card">
    <div class="metrics">
      <span class="metric"><span class="n"><%= @stats[:total] %></span><span class="l">toplam olay</span></span>
      <span class="metric"><span class="n"><%= @stats[:resolved] %> <span class="subtle">/ %<%= @stats[:resolved_pct] %></span></span><span class="l">ajan çözdü</span></span>
      <span class="metric"><span class="n"><%= @stats[:escalated] %></span><span class="l">🚨 insana devredildi</span></span>
      <span class="metric"><span class="n"><%= @stats[:correct] %> <span class="subtle">/ %<%= @stats[:correct_pct] %></span></span><span class="l">doğru kök-neden</span></span>
      <span class="metric"><span class="n"><%= @stats[:avg_conf] ? "%#{@stats[:avg_conf]}" : "-" %></span><span class="l">ortalama güven</span></span>
    </div>
    <p class="subtle" style="margin:14px 0 0">
      Şu an nöbetçi: <strong><%= @on_call&.display_name || "—" %></strong>.
      Jev çıkmaza girerse (düşük güven veya tüm denemeler başarısız) olay bu kişiye alarmlanır.
    </p>
  </div>
<% end %>

<% if @incidents.any? %>
  <table class="queue">
    <thead>
      <tr>
        <th>Referans</th>
        <th>Servis</th>
        <th>Önem</th>
        <th>Ajan seçti</th>
        <th>Doğru</th>
        <th>Güven</th>
        <th>Den.</th>
        <th>Sonuç</th>
      </tr>
    </thead>
    <tbody>
      <% @incidents.each do |incident| %>
        <tr>
          <td><%= link_to incident.reference, incident_path(incident), class: "ref" %></td>
          <td class="subtle"><%= incident.service.name %></td>
          <td>
            <% if incident.severity %><%= ResolutionAgent::SEVERITY_LEVELS[incident.severity] %> (<%= incident.severity %>/4)<% else %>—<% end %>
          </td>
          <td><code><%= incident.agent_action || "—" %></code></td>
          <td>
            <% if incident.agent_action.present? %>
              <% if incident.agent_action_correct? %>
                <span style="color:#16a34a;font-weight:700">✓</span>
              <% else %>
                <span style="color:#dc2626;font-weight:700" title="Doğrusu: <%= incident.root_cause_action %>">✗</span>
              <% end %>
            <% else %>—<% end %>
          </td>
          <td><%= incident.agent_confidence ? "%#{(incident.agent_confidence * 100).round}" : "—" %></td>
          <td><%= incident.resolution_attempts %></td>
          <td>
            <% if incident.status == "resolved" %>
              <%= status_pill("resolved") %>
              <% if incident.auto_resolved %><span class="badge-dup">otomatik</span><% end %>
            <% elsif incident.needs_human %>
              <span class="pill pill--triggered">🚨 insana devredildi</span>
              <span class="subtle"><%= incident.paged_user&.display_name %></span>
            <% else %>
              <%= status_pill(incident.status) %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <div class="card center">
    <p class="subtle">Henüz simüle olay yok. "Olay üret" ile başlat ya da "Canlı mod"u aç.</p>
  </div>
<% end %>
