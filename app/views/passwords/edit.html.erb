<% content_for :title, "Yeni şifre belirle" %>

<div class="card auth-card">
  <div class="center" style="margin-bottom:16px">
    <%= render "shared/logo" %>
    <h1 style="margin:10px 0 2px;font-size:20px">Yeni şifre belirle</h1>
    <p class="subtle" style="margin:0">Hesabın için yeni bir şifre belirle.</p>
  </div>

  <%= form_with url: password_path(params[:token]), method: :put do |form| %>
    <div class="field">
      <%= form.label :password, "Yeni şifre" %>
      <%= form.password_field :password, required: true, autocomplete: "new-password",
            placeholder: "En az 8 karakter", maxlength: 72 %>
    </div>
    <div class="field">
      <%= form.label :password_confirmation, "Yeni şifre (tekrar)" %>
      <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password",
            placeholder: "Tekrar girin", maxlength: 72 %>
    </div>
    <div class="form-actions">
      <%= form.submit "Şifreyi güncelle", class: "btn" %>
    </div>
  <% end %>
</div>
